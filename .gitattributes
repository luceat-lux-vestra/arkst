# Normalize line endings to LF
* text=auto eol=lf

# Rust
*.rs text diff=rust

# Markdown
*.md text diff=markdown
# This fixture intentionally retains CRLF for parser line-ending coverage.
fixtures/markdown/real/12-line-endings-crlf.md -text whitespace=cr-at-eol
# This regression fixture intentionally retains a four-space-only line.
fixtures/quarkdown-conformance/cases/v262-empty-code-regressions/input.qd whitespace=-blank-at-eol
# This regression fixture intentionally retains a tabs-only separator line.
fixtures/quarkdown-conformance/cases/v263-commonmark-regressions/input.qd whitespace=-blank-at-eol

# Typst
*.typ text

# TOML/YAML/JSON
*.toml text
*.yaml text
*.yml text
*.json text

# Shell scripts
*.sh text eol=lf

# Binary fixtures
*.pdf binary
*.png binary
*.jpg binary
*.svg -diff
*.woff2 binary
